<?xml version='1.0'?>
<sdf version='1.6'>
  <model name='duck'>

    <plugin
      filename="gz-sim-pose-publisher-system"
      name="gz::sim::systems::PosePublisher">
      <publish_model_pose>1</publish_model_pose>
      <update_frequency>30</update_frequency>  <!-- 1초에 30회 -->
    </plugin>

    <static>false</static>
    <plugin
        filename="gz-waves-hydrodynamics-system"
        name="gz::sim::systems::Hydrodynamics">
    </plugin>
    <link name="base_link">
      <visual name="visual">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://duck/meshes/duck.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://duck/meshes/duck_collision.stl</uri>
          </mesh>
        </geometry>
      </collision>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>600</mass>
        <inertia>
          <ixx>399</ixx>
          <ixy>0</ixy>
          <iyy>399</iyy>
          <iyz>0</iyz>
          <izz>399</izz>
        </inertia>
      </inertial>
    </link>
  </model>
</sdf>
